@model HospitalManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Create Patient";
}

<h2>Create Patient</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div>
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div>
        <label>Age</label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div>
        <label>Phone</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div>
        <label>Medical History</label>
        <textarea asp-for="MedicalHistory" class="form-control"></textarea>
    </div>

    <div class="border border-2 border-dashed rounded p-4 text-center">
        <label class="form-label fw-bold">Upload Image</label>

        <input asp-for="ClientFile"
               type="file"
               class="form-control d-none"
               id="fileInput"
               accept="image/*"
               onchange="loadfile(event)" />

        <label for="fileInput" class="btn btn-outline-primary mt-2">
            Choose Image
        </label>

        <div class="mt-3">
            <img id="myImg" class="img-thumbnail shadow" style="max-height:200px; display:none;" />
        </div>
    </div>
    <br />
    <hr />
    <button type="submit" class="btn btn-success mt-2">Save</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var loadfile = function (event) {
            var reader = new FileReader();

            reader.onload = function () {
                var myImg = document.getElementById('myImg');
                myImg.src = reader.result;
            };

            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
    <script>
        var loadfile = function (event) {
            var reader = new FileReader();

            reader.onload = function () {
                var img = document.getElementById('myImg');
                img.src = reader.result;
                img.style.display = "block";
            };

            reader.readAsDataURL(event.target.files[0]);
        }
    </script>

}
