@model HospitalManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<h2>Are you sure you want to delete this appointment?</h2>

<ul>
    <li>Patient ID: @Model.PatientId</li>
    <li>Doctor ID: @Model.DoctorId</li>
    <li>Date: @Model.Date</li>
</ul>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>